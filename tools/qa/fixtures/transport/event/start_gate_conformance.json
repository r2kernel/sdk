{
  "contract": "StartGate v1",
  "notes": "Consumed by cpp/test_start_gate.cpp and python/test_start_gate.py. Each scenario prepares a fresh 0700 run directory <run> with gate <run>/ready, applies setup actions in order, then runs one step and expects the given error code (or success). consumer_only scenarios use the helper-side API, which only the Python fixture provides. requires_root scenarios run only as root. close_publisher closes the Python gate and moves the C++ gate away (the moved-from gate stays in use). create_private_empty_ack creates an empty unlocked 0600 acknowledgement (a publisher between its exclusive create and its write); helper_probe_after_ack_open runs the helper's acknowledged() between the publisher's exclusive create and its lock and requires False.",
  "scenarios": [
    {"name": "success", "setup": ["construct"], "step": "acknowledge_then_open", "expect": "ok"},
    {"name": "gate_preexists", "setup": ["create_gate"], "step": "construct", "expect": "gate_exists"},
    {"name": "gate_appears_before_ack", "setup": ["construct", "create_gate"], "step": "acknowledge", "expect": "gate_exists"},
    {"name": "ack_preexists", "setup": ["create_ack", "construct"], "step": "acknowledge", "expect": "ack_exists"},
    {"name": "ack_symlink_preexists", "setup": ["create_ack_symlink", "construct"], "step": "acknowledge", "expect": "ack_exists"},
    {"name": "directory_replaced_before_ack", "setup": ["construct", "replace_run_directory"], "step": "acknowledge", "expect": "directory_changed"},
    {"name": "directory_replaced_after_ack_create", "setup": ["construct", "replace_run_directory_after_ack_create"], "step": "acknowledge", "expect": "directory_changed"},
    {"name": "directory_replaced_before_opened", "setup": ["construct", "acknowledge", "replace_run_directory"], "step": "opened", "expect": "directory_changed"},
    {"name": "symlinked_parent", "setup": ["symlink_parent"], "step": "construct", "expect": "parent_unsafe"},
    {"name": "parent_mode_0750", "setup": ["chmod_parent_0750"], "step": "construct", "expect": "parent_unsafe"},
    {"name": "parent_foreign_owner", "setup": ["chown_parent_foreign"], "step": "construct", "expect": "parent_unsafe", "requires_root": true},
    {"name": "relative_path", "setup": ["relative_gate_path"], "step": "construct", "expect": "invalid_path"},
    {"name": "dot_component_path", "setup": ["dot_component_gate_path"], "step": "construct", "expect": "invalid_path"},
    {"name": "double_slash_path", "setup": ["double_slash_gate_path"], "step": "construct", "expect": "invalid_path"},
    {"name": "trailing_slash_path", "setup": ["trailing_slash_gate_path"], "step": "construct", "expect": "invalid_path"},
    {"name": "invalid_session", "setup": ["construct"], "step": "acknowledge_invalid_session", "expect": "invalid_identity"},
    {"name": "invalid_publisher_name", "setup": ["construct"], "step": "acknowledge_invalid_publisher", "expect": "invalid_identity"},
    {"name": "gate_symlink", "setup": ["construct", "acknowledge", "gate_kind:symlink"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "gate_directory", "setup": ["construct", "acknowledge", "gate_kind:directory"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "gate_fifo", "setup": ["construct", "acknowledge", "gate_kind:fifo"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "gate_hardlink", "setup": ["construct", "acknowledge", "gate_kind:hardlink"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "gate_nonempty", "setup": ["construct", "acknowledge", "gate_kind:content"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "gate_public_mode", "setup": ["construct", "acknowledge", "gate_kind:public"], "step": "opened", "expect": "gate_unsafe"},
    {"name": "acknowledge_after_close", "setup": ["construct", "close_publisher"], "step": "acknowledge", "expect": "gate_closed"},
    {"name": "opened_after_close", "setup": ["construct", "acknowledge", "close_publisher"], "step": "opened", "expect": "gate_closed"},
    {"name": "publisher_exit_releases_lock", "setup": ["construct", "acknowledge", "release_publisher"], "step": "ack_lock_free", "expect": "ok"},
    {"name": "publisher_exit_keeps_gate_closed", "setup": ["construct", "acknowledge", "release_publisher"], "step": "consumer_acknowledged", "expect": "publisher_exited", "consumer_only": true},
    {"name": "helper_sees_ack_symlink", "setup": ["create_ack_symlink"], "step": "consumer_acknowledged", "expect": "ack_unsafe", "consumer_only": true},
    {"name": "helper_opens_gate_twice", "setup": ["construct", "acknowledge"], "step": "consumer_open_twice", "expect": "gate_exists", "consumer_only": true},
    {"name": "wrong_publisher_keeps_gate_closed", "setup": ["construct", "acknowledge"], "step": "consumer_acknowledged_other_name", "expect": "not_acknowledged", "consumer_only": true},
    {"name": "helper_sees_unwritten_ack", "setup": ["create_private_empty_ack"], "step": "consumer_acknowledged", "expect": "not_acknowledged", "consumer_only": true},
    {"name": "helper_probe_in_ack_create_window", "setup": ["construct", "helper_probe_after_ack_open"], "step": "acknowledge", "expect": "ok", "consumer_only": true}
  ]
}
